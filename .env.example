# Required in production
DATABASE_URL=postgresql://user:password@host/database
SECRET_KEY=replace-with-at-least-32-random-characters
APP_LOGIN_EMAIL=daryl@example.com
APP_LOGIN_PASSWORD=replace-with-a-unique-password
PUBLIC_BASE_URL=https://your-service.onrender.com

# Optional Google Drive picker (set both or neither)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_API_KEY=

# Optional email alerts
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
ALERT_DELIVERY_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# Optional urgent SMS alerts
ALERT_SMS_ENABLED=false
ALERT_SMS_TO=
ALERT_SMS_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TRACERFY_API_TOKEN=
